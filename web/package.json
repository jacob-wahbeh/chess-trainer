{
	"name": "chess-trainer-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:lan": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"test:watch": "vitest",
		"openings": "node scripts/build-openings.mjs",
		"engine": "node scripts/fetch-engine.mjs"
	},
	"dependencies": {
		"chessground": "^9.2.1",
		"chessops": "^0.15.1",
		"comlink": "^4.4.2",
		"dexie": "^4.4.7"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^3.2.7"
	}
}
